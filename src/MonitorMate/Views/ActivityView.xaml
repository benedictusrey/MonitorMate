<UserControl x:Class="MonitorMate.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MonitorMate.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Activity" Style="{StaticResource H1}" />
                <TextBlock Text="The rhythm MonitorMate has seen while it was running." FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Reset history" Style="{StaticResource FlatButton}" Padding="7,4" FontSize="11"
                    Command="{Binding ResetHistoryCommand}" VerticalAlignment="Bottom" />
        </Grid>

        <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource MetricNumber}" FontSize="22" />
                    <TextBlock Text="screen time, 7 days" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,1,0,1" />
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="{Binding AverageText}" Style="{StaticResource MetricNumber}" FontSize="22" />
                    <TextBlock Text="daily average" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <Border Grid.Column="3" Background="{StaticResource BorderBrush}" Margin="0,1,0,1" />
                <StackPanel Grid.Column="4" Margin="12,0,0,0">
                    <TextBlock Text="{Binding FocusText}" Style="{StaticResource MetricNumber}" FontSize="22" />
                    <TextBlock Text="focus time" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <Border Grid.Column="5" Background="{StaticResource BorderBrush}" Margin="0,1,0,1" />
                <StackPanel Grid.Column="6" Margin="12,0,0,0">
                    <TextBlock Text="{Binding AdherenceText}" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="break rhythm" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="This week" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding WeekRange}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Today" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="5,0,10,0" />
                        <Ellipse Width="5" Height="5" Fill="{StaticResource BorderStrongBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Earlier" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="5,0,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Height="148" Margin="0,8,0,0">
                    <controls:WeeklyBars ItemsSource="{Binding WeekPoints}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}">
                        <controls:MateFace Width="36" Height="30" HorizontalAlignment="Center" />
                        <TextBlock Text="No activity yet" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        <TextBlock Text="I'll fill this in while you work." FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Counted only while MonitorMate is running and you are active. Not a system-wide report."
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Day by day" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding WeekPoints}" Margin="0,7,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DateLabel}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="{Binding ScreenMinutes, StringFormat={}{0} min}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding BreaksCompleted, StringFormat={}{0} breaks}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14">
                <StackPanel>
                    <TextBlock Text="A gentle read" Style="{StaticResource H2}" />
                    <TextBlock Text="Longest tracked day" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding BestDayText}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9,0,7" />
                    <TextBlock Text="The useful number is not total screen time. It is whether you looked away often enough."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Stored on this PC only. No account, no upload." FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>

