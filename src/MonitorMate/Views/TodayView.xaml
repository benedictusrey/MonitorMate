<UserControl x:Class="MonitorMate.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MonitorMate.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Identify displays" Style="{StaticResource FlatButton}" Padding="7,4"
                    Command="{Binding IdentifyCommand}" FontSize="11" VerticalAlignment="Bottom" />
        </Grid>

        <!-- First run: one strip, no numbered tour. -->
        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AmberBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding IsSetupVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Choose display control" FontSize="11" Foreground="{StaticResource AmberBrush}" />
                    <TextBlock Text="Use manual controls, or allow scheduled changes. You can change this later."
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                               TextWrapping="Wrap" MaxWidth="410" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Use manually" Style="{StaticResource FlatButton}" Padding="9,5" FontSize="11"
                            Command="{Binding FinishSetupCommand}" />
                    <Button Content="Enable automatic" Style="{StaticResource PrimaryButton}" Padding="11,5" FontSize="11"
                            Command="{Binding EnableAutomaticCommand}" Margin="5,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Light rail: the page's one memorable instrument, full width. -->
        <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <TextBlock Text="The light today" Style="{StaticResource H2}" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="Now " /><Run Text="{Binding NowTimeText, Mode=OneWay}" />
                    </TextBlock>
                </Grid>

                <controls:DayRibbon Height="34" Margin="0,12,0,2"
                                    AutomationProperties.Name="Daily light schedule"
                                    DayStart="{Binding DayStartMinutes}"
                                    EveningStart="{Binding EveningStartMinutes}"
                                    NightStart="{Binding NightStartMinutes}"
                                    Now="{Binding NowMinutes}" />

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource SandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SunriseText}" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Daylight" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SunsetText}" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Evening" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource SlateBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NightStartText}" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Night" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPresetName}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20" FontWeight="Light" Foreground="{StaticResource AmberBrush}" />
                        <TextBlock Text="{Binding DisplaySummary}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding ScheduleNextText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                            <Button Content="Open displays" Style="{StaticResource FlatButton}" Padding="6,4" FontSize="11"
                                    Command="{Binding OpenDisplaysCommand}" />
                            <Button Content="Adjust schedule" Style="{StaticResource FlatButton}" Padding="6,4" FontSize="11"
                                    Command="{Binding OpenComfortCommand}" Margin="2,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ScheduleWarning}" FontSize="11" Foreground="{StaticResource AmberBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding ScheduleWarning, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="15,13" Margin="0,0,10,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Today's rhythm" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding CurrentPresetName}" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="5" Height="5" Fill="{StaticResource SandBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Daylight" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text="Neutral colour for bright rooms" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SunriseText}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AmberBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Evening" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text="Softer, warmer light as day fades" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SunsetText}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="5" Height="5" Fill="{StaticResource SlateBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Night" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text="Low light with a deep warm cast" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding NightStartText}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="15,13">
                <StackPanel>
                    <TextBlock Text="Quick actions" Style="{StaticResource H2}" />
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"
                                Command="{Binding OpenDisplaysCommand}" Padding="5,5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconMonitor}" Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                                <TextBlock Text="Adjust display" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"
                                Command="{Binding IdentifyCommand}" Padding="5,5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDisplaySettings}" Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                                <TextBlock Text="Identify" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"
                                Command="{Binding OpenBreaksCommand}" Padding="5,5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCoffee}" Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                                <TextBlock Text="Tune breaks" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"
                                Command="{Binding TakeBreakCommand}" Padding="5,5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Stroke="{StaticResource AmberBrush}"
                                      StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                                <TextBlock Text="Take a break" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource AmberBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"
                                Command="{Binding OpenFocusCommand}" Padding="5,5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFocus}" Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                                <TextBlock Text="Focus" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"
                                Command="{Binding OpenActivityCommand}" Padding="5,5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconChart}" Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                                <TextBlock Text="Activity" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource CardBorder}" Padding="13,9" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource IconFocus}" Stroke="{StaticResource TextSecondaryBrush}"
                      StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="9,0,10,0">
                    <TextBlock Text="Focus today" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding FocusStatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FocusText}" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="today" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="5,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="12,7" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Shortcuts" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ShortcutHint}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Margin="10,0,10,0" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Content="Settings" Style="{StaticResource FlatButton}" Padding="6,3"
                        FontSize="11" Command="{Binding OpenSettingsCommand}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
