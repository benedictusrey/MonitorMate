<UserControl x:Class="MonitorMate.Views.ComfortView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MonitorMate.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Comfort" Style="{StaticResource H1}" />
                <TextBlock Text="Colour, warmth and the rhythm of the day." FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Windows Night light" Style="{StaticResource FlatButton}" Padding="7,4" FontSize="11"
                        Command="{Binding OpenNightLightCommand}" />
                <Button Content="Colour management" Style="{StaticResource FlatButton}" Padding="7,4" FontSize="11"
                        Command="{Binding OpenColorManagementCommand}" Margin="3,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Presets" Style="{StaticResource H2}" />
                            <TextBlock Text="A starting point for every display. Each screen keeps its own values."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentPresetName}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   FontSize="11" Foreground="{StaticResource AmberBrush}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Presets}" Margin="0,9,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PresetCard}" Margin="0,0,6,6" Padding="10,8"
                                        Command="{Binding ApplyCommand}" CommandParameter="{Binding Id}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="11.2" FontWeight="SemiBold" />
                                            <Ellipse Width="4" Height="4" Fill="{StaticResource AmberBrush}" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                                   Margin="0,3,0,0" MaxHeight="26" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding TemperatureText}" FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding BrightnessText}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="7,1,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource SettingHint}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Daily rhythm" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding ScheduleDescription}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchToggle}" Content="Schedule" IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9,0,8" />

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ChipRadio}" Content="Fixed hours" FontSize="11"
                                     IsChecked="{Binding UseSolar, Converter={StaticResource InverseBool}, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource ChipRadio}" Content="Sunrise &amp; sunset" FontSize="11" Margin="6,0,0,0"
                                     IsChecked="{Binding UseSolar, Mode=TwoWay}" />
                    </StackPanel>

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Daylight" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                            <TextBox Style="{StaticResource AppTextBox}" Text="{Binding DayStartText, UpdateSourceTrigger=LostFocus}"
                                     Padding="7,5" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="Evening" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                            <TextBox Style="{StaticResource AppTextBox}" Text="{Binding EveningStartText, UpdateSourceTrigger=LostFocus}"
                                     Padding="7,5" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Night" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                            <TextBox Style="{StaticResource AppTextBox}" Text="{Binding NightStartText, UpdateSourceTrigger=LostFocus}"
                                     Padding="7,5" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding UseSolar, Converter={StaticResource BoolToVisibility}}" Margin="0,9,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Latitude" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding LatitudeText, UpdateSourceTrigger=LostFocus}"
                                         Padding="7,5" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Longitude" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding LongitudeText, UpdateSourceTrigger=LostFocus}"
                                         Padding="7,5" FontSize="11" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SolarPreview}" Style="{StaticResource SettingHint}" />
                    </StackPanel>

                    <TextBlock Text="24-hour time, for example 19:00. Solar times are estimated offline."
                               Style="{StaticResource SettingHint}" Margin="0,7,0,0" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9,0,8" />
                    <TextBlock Text="{Binding ScheduleStatus}" FontSize="11" Foreground="{StaticResource MintBrush}" />
                    <TextBlock Text="{Binding NextChange}" Style="{StaticResource SettingHint}" />
                    <TextBlock Text="{Binding ScheduleWarning}" FontSize="11" Foreground="{StaticResource AmberBrush}"
                               TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding HasSolarWarning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ScheduleError}" FontSize="11" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Save schedule" Style="{StaticResource PrimaryButton}" Padding="11,6" FontSize="11"
                            Command="{Binding ApplyScheduleCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <TextBlock Text="MonitorMate adds per-display warmth and a reversible layer. It does not replace calibrated colour management."
                               Style="{StaticResource SettingHint}" Margin="0,9,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="The day at a glance" Style="{StaticResource H2}" />
                    <controls:DayRibbon Height="30" Margin="0,8,0,2"
                                        AutomationProperties.Name="Daily light schedule"
                                        DayStart="{Binding DayStartMinutes}"
                                        EveningStart="{Binding EveningStartMinutes}"
                                        NightStart="{Binding NightStartMinutes}"
                                        Now="{Binding NowMinutes}" />
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource SandBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SunriseText}" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Daylight" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SunsetText}" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Evening" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource SlateBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NightStartText}" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Night" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="Current" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding CurrentPresetName}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="18" Foreground="{StaticResource AmberBrush}" Margin="0,1,0,0" />
                    <TextBlock Text="{Binding ScheduleStatus}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding NextChange}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
