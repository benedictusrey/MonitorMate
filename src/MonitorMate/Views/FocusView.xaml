<UserControl x:Class="MonitorMate.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MonitorMate.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Focus" Style="{StaticResource H1}" />
                <TextBlock Text="Give one thing the room it needs." FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"  TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Choose your focus" Style="{StaticResource H2}" />
                            <TextBlock Text="Click-through. It changes what you see, not how your apps work."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"  TextWrapping="Wrap" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PillBorder}"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Focus is on" FontSize="11" Foreground="{StaticResource MintBrush}" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Style="{StaticResource ChoiceCard}" GroupName="FocusMode" Margin="0,0,6,0" Padding="9,7"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Reading, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Reading band" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="A clear horizontal band for long reading." FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"  TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Style="{StaticResource ChoiceCard}" GroupName="FocusMode" Margin="6,0,0,0" Padding="9,7"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Spotlight, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Spotlight" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="A soft area around your pointer." FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"  TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Height="128" Margin="0,8,0,0" ClipToBounds="True">
                        <Grid>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mode}" Value="Reading">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Height="52" Fill="#28D8B36A" VerticalAlignment="Center" />
                                <Rectangle Height="1" Fill="#70D8B36A" VerticalAlignment="Center" />
                                <TextBlock Text="Reading band" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{StaticResource SandBrush}" />
                                <TextBlock Text="The rest of the screen recedes." HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom" Margin="0,0,0,12" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            </Grid>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mode}" Value="Spotlight">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Ellipse Width="170" Height="92" Fill="#28D8B36A" Stroke="#70D8B36A" StrokeThickness="1" />
                                <TextBlock Text="Spotlight" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{StaticResource SandBrush}" />
                                <TextBlock Text="The clear area follows your pointer." HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom" Margin="0,0,0,12" FontSize="11" Foreground="{StaticResource TextMutedBrush}"  TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource SettingHint}" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,7" />
                    <TextBlock Text="Fine-tune" Style="{StaticResource H3}" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="Dim the rest of the screen" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DimText}" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{StaticResource AmberBrush}" />
                    </Grid>
                    <Slider AutomationProperties.Name="Surrounding screen dimming" Style="{StaticResource AppSlider}" Minimum="20" Maximum="85" TickFrequency="1"
                            IsSnapToTickEnabled="True" Value="{Binding DimPercent, Mode=TwoWay}" />
                    <Grid Margin="0,3,0,0">
                        <TextBlock Text="Reading band height" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding BandHeight, StringFormat={}{0} px}" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                    <Slider AutomationProperties.Name="Reading band height" Style="{StaticResource AppSlider}" Minimum="120" Maximum="500" TickFrequency="10"
                            IsSnapToTickEnabled="True" Value="{Binding BandHeight, Mode=TwoWay}" />
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Style="{StaticResource SwitchToggle}" Content="Follow pointer" FontSize="11"
                                      IsChecked="{Binding FollowPointer, Mode=TwoWay}" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" Content="Hide window" FontSize="11"
                                      IsChecked="{Binding HideMainWindow, Mode=TwoWay}" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Session" Style="{StaticResource H2}" />
                    <Grid Width="122" Height="122" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <controls:RingProgress Progress="{Binding Progress}" Thickness="3"
                                               TrackBrush="{StaticResource BorderBrush}" ProgressBrush="{StaticResource AmberBrush}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="25" FontWeight="Light" HorizontalAlignment="Center" />
                            <TextBlock Text="remaining" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextAlignment="Center" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <Button Content="{Binding StartStopLabel}" Style="{StaticResource PrimaryButton}" Padding="11,6" FontSize="11"
                            Command="{Binding StartStopCommand}" Margin="0,10,0,0" />
                    <TextBlock Text="Press Esc to end a session." FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextAlignment="Center" Margin="0,5,0,0" />
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9,0,7" />
                    <TextBlock Text="Session length" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="Minutes" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding DurationText}" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                    <Slider AutomationProperties.Name="Focus session length in minutes" Style="{StaticResource AppSlider}" Minimum="5" Maximum="90" TickFrequency="5"
                            IsSnapToTickEnabled="True" Value="{Binding DefaultMinutes, Mode=TwoWay}" />
                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="9" Margin="0,7,0,0">
                        <TextBlock Text="Pair a focus session with a gentle break afterwards. Distance and time away both help."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Click-through" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="The overlay never takes your pointer." FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,1,0,1" />
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Esc ends it" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="One key, no menu to hunt for." FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="3" Background="{StaticResource BorderBrush}" Margin="0,1,0,1" />
                <StackPanel Grid.Column="4" Margin="12,0,0,0">
                    <TextBlock Text="No screen capture" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="Focus counts time, not content." FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
