<Window x:Class="MonitorMate.Views.Overlays.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorMate"
        Width="404" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="False">
    <Border Margin="12" Background="#F2161D16" BorderBrush="#2F3A2F" BorderThickness="1"
            CornerRadius="10" Padding="16,13,12,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="3" Height="16" CornerRadius="2" Background="#E07A5F" Margin="0,1,10,0" />
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F4EFE4" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" Width="24" Height="24"
                        Style="{StaticResource FlatButton}" Padding="0" Click="CloseButton_Click"
                        AutomationProperties.Name="Dismiss notification">
                    <Path Data="{StaticResource IconClose}" Stroke="#889384" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
                </Button>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Message}" Margin="13,7,10,0" FontSize="12.5"
                       LineHeight="19" TextWrapping="Wrap" Foreground="#B7BFB2" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="SecondaryButton" Style="{StaticResource FlatButton}" Padding="12,7"
                        Content="{Binding SecondaryLabel}" Click="SecondaryButton_Click"
                        Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibility}}" />
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Padding="14,7"
                        Content="{Binding PrimaryLabel}" Click="PrimaryButton_Click" Margin="6,0,0,0"
                        Visibility="{Binding HasPrimary, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
