<Window x:Class="MonitorMate.Views.Overlays.IdentifyOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorMate identify display"
        Width="1920" Height="1080"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="False" IsHitTestVisible="False">
    <Grid Background="#660C100D">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F2161D16" BorderBrush="#2F3A2F" BorderThickness="1"
                CornerRadius="12" Padding="32,24" MinWidth="280">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding NumberText}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="64" FontWeight="Light" Foreground="#E07A5F"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"
                           Foreground="#F4EFE4" HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Resolution}" FontSize="11.5" Foreground="#B7BFB2"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                <Border Background="#1FE07A5F" CornerRadius="7" Padding="8,2" Margin="0,11,0,0"
                        HorizontalAlignment="Center" Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Primary display" FontSize="11" Foreground="#E07A5F" />
                </Border>
            </StackPanel>
        </Border>
        <TextBlock Text="This card fades automatically." HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,26" FontSize="11" Foreground="#889384" />
    </Grid>
</Window>
