<Window x:Class="MonitorMate.Views.Overlays.FocusOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorMate focus"
        Width="1920" Height="1080"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True" IsHitTestVisible="False">
    <Grid>
        <Path x:Name="Curtain" Fill="#0C100D" Opacity="{Binding DimOpacity}" IsHitTestVisible="False" />
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0"
                Background="#CC141914" BorderBrush="#2F3A2F" BorderThickness="1"
                CornerRadius="10" Padding="13,6" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="5" Height="5" Fill="#E07A5F" VerticalAlignment="Center" />
                <TextBlock Text="{Binding HintText}" Margin="8,0,0,0" FontSize="11"
                           Foreground="#B7BFB2" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
