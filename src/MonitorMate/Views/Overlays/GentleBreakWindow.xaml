<Window x:Class="MonitorMate.Views.Overlays.GentleBreakWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MonitorMate.Controls"
        Title="MonitorMate gentle break"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="False">
    <Border Margin="12" Background="#F218232D" BorderBrush="#3A4D59" BorderThickness="1"
            CornerRadius="14" Padding="18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="7" Direction="270" Opacity="0.32" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="58" Height="58" VerticalAlignment="Top">
                <controls:RingProgress Progress="{Binding Progress}" Thickness="3"
                                       TrackBrush="#22FFFFFF" ProgressBrush="#6EE7C7" />
                <TextBlock Text="{Binding CountdownText}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="15" FontWeight="Light" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="#F2F6F8" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="{Binding LengthLabel}" FontSize="11.5" Foreground="#6EE7C7" />
                <TextBlock Text="{Binding Prompt}" FontSize="14.5" FontWeight="SemiBold"
                           Foreground="#F2F6F8" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding SubPrompt}" FontSize="12" Foreground="#A7B5C0"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <Button Content="Skip break" Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                        Padding="10,6" Margin="0,8,0,0" Click="SkipButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
