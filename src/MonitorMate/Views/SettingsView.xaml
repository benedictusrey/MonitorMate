<UserControl x:Class="MonitorMate.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource H1}" />
                <TextBlock Text="Small decisions that keep MonitorMate out of the way." FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource H2}" />
                    <TextBlock Text="These apply the next time MonitorMate starts." FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,8" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Start with Windows" FontSize="11.2"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  Visibility="{Binding CanStartWithWindows, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StartupError}" FontSize="11" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding StartupError, Converter={StaticResource StringToVisibility}}" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Start minimized to the tray" FontSize="11.2"
                                  IsChecked="{Binding StartMinimized, Mode=TwoWay}" Margin="0,7,0,0" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Keep running when I close" FontSize="11.2"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}" Margin="0,7,0,0" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Sound cues for breaks" FontSize="11.2"
                                  IsChecked="{Binding SoundEnabled, Mode=TwoWay}" Margin="0,7,0,0" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Restore my last comfort" FontSize="11.2"
                                  IsChecked="{Binding RestoreOnLaunch, Mode=TwoWay}" Margin="0,7,0,0" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Reduce motion" FontSize="11.2"
                                  IsChecked="{Binding ReducedMotion, Mode=TwoWay}" Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,6" />
                    <TextBlock FontSize="11.2" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Created by Benedictus RH " /><Hyperlink
                            NavigateUri="https://github.com/benedictusrey"
                            RequestNavigate="Credit_RequestNavigate"
                            AutomationProperties.Name="@benedictusrey on GitHub">@benedictusrey</Hyperlink>
                    </TextBlock>
                    <TextBlock Text="Your MonitorMate lives in the sidebar. It watches the light and the clock so you can keep working."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,7" />
                    <TextBlock Text="Your data" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding DataPath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <Button Content="Open data folder" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="11"
                            Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    <TextBlock Text="Local only. No account, no telemetry, no upload." FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Button Content="Reset history" Style="{StaticResource FlatButton}" Padding="0,3,0,0" FontSize="11"
                                Command="{Binding ResetHistoryCommand}" />
                        <Button Content="Reset settings" Style="{StaticResource FlatButton}" Padding="8,3,0,0" FontSize="11"
                                Command="{Binding ResetSettingsCommand}" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Global shortcuts" Style="{StaticResource H2}" />
                        <TextBlock Text="Work while MonitorMate is running, even from the tray." FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Enable" FontSize="11"
                                  IsChecked="{Binding HotkeysEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <ItemsControl ItemsSource="{Binding HotkeyRows}" Margin="0,7,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}" Text="{Binding Gesture, UpdateSourceTrigger=LostFocus}"
                                         Margin="10,0,0,0" Padding="7,4" FontSize="11" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="2" Text="{Binding Error}" FontSize="11" Foreground="{StaticResource DangerBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="160" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding HotkeyConflicts}" FontSize="11" Foreground="{StaticResource AmberBrush}"
                           TextWrapping="Wrap" Margin="0,3,0,0"
                           Visibility="{Binding HotkeyConflicts, Converter={StaticResource StringToVisibility}}" />
                <Button Content="Restore defaults" Style="{StaticResource FlatButton}" Padding="0,5,0,0" FontSize="11"
                        Command="{Binding ResetHotkeysCommand}" HorizontalAlignment="Left" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Diagnostics" Style="{StaticResource H2}" />
                        <TextBlock Text="See what Windows exposes for each display. Nothing leaves this PC."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Content="Show details" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="11"
                            Command="{Binding ToggleDiagnosticsCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <StackPanel Visibility="{Binding IsDiagnosticsOpen, Converter={StaticResource BoolToVisibility}}">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9,0,7" />
                    <ItemsControl ItemsSource="{Binding DiagnosticRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding ControlPath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" MaxWidth="170" TextWrapping="Wrap" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="9" Margin="0,4,0,7">
                        <TextBlock Text="{Binding DiagnosticsText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" MaxHeight="120" />
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Copy report" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                Command="{Binding CopyDiagnosticsCommand}" />
                        <Button Content="Export" Style="{StaticResource FlatButton}" Padding="6,3" FontSize="11"
                                Command="{Binding ExportDiagnosticsCommand}" Margin="3,0,0,0" />
                        <Button Content="Refresh" Style="{StaticResource FlatButton}" Padding="6,3" FontSize="11"
                                Command="{Binding RefreshDisplaysCommand}" Margin="3,0,0,0" />
                        <Button Content="Recapture gamma" Style="{StaticResource FlatButton}" Padding="6,3" FontSize="11"
                                Command="{Binding RecaptureBaselinesCommand}" Margin="3,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

