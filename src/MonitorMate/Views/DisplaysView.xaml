<UserControl x:Class="MonitorMate.Views.DisplaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Displays" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding DisplayCountText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Identify" Style="{StaticResource FlatButton}" Padding="7,4" FontSize="11" Command="{Binding IdentifyCommand}" />
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11"
                        Command="{Binding RefreshCommand}" Margin="3,0,0,0" />
                <Button Content="Windows display settings" Style="{StaticResource FlatButton}" Padding="7,4" FontSize="11"
                        Command="{Binding OpenWindowsDisplaySettingsCommand}" Margin="3,0,0,0" />
            </StackPanel>
        </Grid>

        <ListBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource MonitorCardContainer}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding NumberLabel}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="12" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="120" />
                            <TextBlock Text="{Binding ControlPathLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                        </StackPanel>
                        <Ellipse Grid.Column="2" Width="5" Height="5" VerticalAlignment="Top" Margin="5,3,0,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource MintBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusTone}" Value="warn">
                                            <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusTone}" Value="error">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="14"
                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource H2}">
                            <Setter Property="Text" Value="Choose a display" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Text" Value="No displays found" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Pick one of the screens above to adjust its brightness, warmth and contrast." />
                            <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Text" Value="Check the display connection, then choose Refresh. Breaks and focus remain available." /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Message}" Style="{StaticResource SettingHint}" />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,10,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDisplay.Name}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding SelectedDisplay.ControlDetail}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PillBorder}">
                            <TextBlock Text="{Binding SelectedDisplay.ControlPathLabel}" FontSize="11"
                                       Foreground="{StaticResource MintBrush}" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedDisplay.BrightnessCaption}" Style="{StaticResource SettingLabel}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedDisplay.BrightnessText}" Style="{StaticResource DisplayM}" />
                    </Grid>
                    <Slider Style="{StaticResource AppSlider}" Minimum="10" Maximum="100"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding SelectedDisplay.Brightness, Mode=TwoWay}"
                            Margin="0,0,0,0" IsEnabled="{Binding HasSelection}" />
                    <Grid>
                        <TextBlock Text="Dimmer" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="Brighter" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Colour temperature" Style="{StaticResource SettingLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedDisplay.TemperatureDescription}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SelectedDisplay.TemperatureText}" Style="{StaticResource DisplayM}" />
                        </StackPanel>
                    </Grid>
                    <Slider Style="{StaticResource AppSlider}" Minimum="2700" Maximum="6500"
                            TickFrequency="50" IsSnapToTickEnabled="True"
                            Value="{Binding SelectedDisplay.TemperatureK, Mode=TwoWay}"
                            Margin="0,0,0,0" IsEnabled="{Binding HasSelection}" />
                    <Grid>
                        <TextBlock Text="Warmer" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="Neutral" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0"
                                    Visibility="{Binding SelectedDisplay.ShowExtraDim, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <TextBlock Text="Extra dim" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{Binding SelectedDisplay.ExtraDimText}" HorizontalAlignment="Right"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                            <Slider Style="{StaticResource AppSlider}" Minimum="0" Maximum="50"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedDisplay.SoftwareDim, Mode=TwoWay}" />
                            <TextBlock Text="Below hardware minimum." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Visibility="{Binding SelectedDisplay.CanAdjustContrast, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <TextBlock Text="Contrast" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{Binding SelectedDisplay.ContrastText}" HorizontalAlignment="Right"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                            <Slider Style="{StaticResource AppSlider}" Minimum="0" Maximum="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedDisplay.Contrast, Mode=TwoWay}" />
                            <TextBlock Text="Sent over DDC/CI." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,9,0,0">
                        <TextBlock Text="Comfort presets" Style="{StaticResource SettingLabel}" />
                        <Button Content="Apply to all" Style="{StaticResource FlatButton}" Padding="0,2,0,0" FontSize="11"
                                Command="{Binding ApplyToAllCommand}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Presets}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PresetCard}" Margin="0,0,6,6"
                                        Command="{Binding ApplyCommand}" CommandParameter="{Binding Id}"
                                        ToolTip="{Binding Description}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                                            <Ellipse Width="4" Height="4" Fill="{StaticResource AmberBrush}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                                     Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding TemperatureText}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding PreviewLabel}" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="11"
                                    Command="{Binding PreviewOriginalCommand}" />
                            <Button Content="Reset this display" Style="{StaticResource FlatButton}" Padding="7,4" FontSize="11"
                                    Command="{Binding ResetSelectedCommand}" Margin="3,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource SettingHint}" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Margin="10,10,0,0">
                <Border Style="{StaticResource CardBorder}" Padding="13">
                    <StackPanel>
                        <TextBlock Text="Control path" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding SelectedDisplay.StatusText}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDisplay.StatusTone}" Value="warn">
                                            <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedDisplay.StatusTone}" Value="error">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedDisplay.StatusDetail}" Style="{StaticResource SettingHint}"
                                   Visibility="{Binding SelectedDisplay.StatusDetail, Converter={StaticResource StringToVisibility}}" />
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9,0,8" />
                        <Grid>
                            <TextBlock Text="Control route" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedDisplay.ControlPathLabel}" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <TextBlock Text="Gamma ramp" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedDisplay.GammaStatusText}" FontSize="11"
                                       HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="A readable gamma ramp does not guarantee write support. Warmth and dimming stay within Windows limits; slider values are targets." Style="{StaticResource SettingHint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="13" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="At a glance" Style="{StaticResource H3}" />
                        <Grid Margin="0,7,0,0">
                            <TextBlock Text="Resolution" Style="{StaticResource SettingHint}" />
                            <TextBlock Text="{Binding SelectedDisplay.Resolution}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Position" Style="{StaticResource SettingHint}" />
                            <TextBlock Text="{Binding SelectedDisplay.PositionLabel}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Adapter" Style="{StaticResource SettingHint}" />
                            <TextBlock Text="{Binding SelectedDisplay.AdapterName}" HorizontalAlignment="Right" FontSize="11"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150" />
                        </Grid>
                        <Button Content="Identify this display" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11"
                                Command="{Binding IdentifyCommand}" Margin="0,11,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
