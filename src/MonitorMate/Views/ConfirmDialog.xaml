<Window x:Class="MonitorMate.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorMate"
        Width="450" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Margin="16" Background="#17222B" BorderBrush="#3A4D59" BorderThickness="1" CornerRadius="14" Padding="24,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="9" Direction="270" Opacity="0.4" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="Light" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Body}" Margin="0,9,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}" Click="Confirm_Click" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
