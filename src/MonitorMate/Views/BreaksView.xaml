<UserControl x:Class="MonitorMate.Views.BreaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MonitorMate.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Breaks" Style="{StaticResource H1}" />
                <TextBlock Text="A rhythm you can keep, even on a busy day." FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Preview" Style="{StaticResource FlatButton}" Padding="7,4" FontSize="11" Command="{Binding PreviewCommand}" />
                <Button Content="Take a break" Style="{StaticResource PrimaryButton}" Padding="11,5" FontSize="11"
                        Command="{Binding TakeBreakCommand}" Margin="4,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="118" Height="118" Margin="0,0,18,0">
                    <controls:RingProgress Progress="{Binding Progress}" Thickness="3"
                                           TrackBrush="{StaticResource BorderBrush}" ProgressBrush="{StaticResource MintBrush}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CountdownText}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="24" FontWeight="Light" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PhaseLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NextBreakText}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AdherenceText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Border Style="{StaticResource PillBorder}" Margin="0,0,5,0">
                            <TextBlock Text="{Binding CompletedToday, StringFormat={}{0} completed}" FontSize="11"
                                       Foreground="{StaticResource MintBrush}" />
                        </Border>
                        <Border Style="{StaticResource PillBorder}">
                            <TextBlock Text="{Binding SkippedToday, StringFormat={}{0} skipped}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="The timer is paused while you are away." FontSize="11"
                               Foreground="{StaticResource AmberBrush}" Margin="0,5,0,0"
                               Visibility="{Binding IsIdlePaused, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Paused while a full-screen app is active." FontSize="11"
                               Foreground="{StaticResource AmberBrush}" Margin="0,5,0,0"
                               Visibility="{Binding IsFullscreenPaused, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Break reminders"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Right" />
                    <Button Content="Restart interval" Style="{StaticResource FlatButton}" Padding="0,5,0,0" FontSize="11"
                            Command="{Binding ResetCommand}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Rhythm" Style="{StaticResource H2}" />
                    <TextBlock Text="Change intervals below at any time. A long break follows the last cycle in each set."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,0"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="430" />
                </Grid>
                <ItemsControl ItemsSource="{Binding RhythmOptions}" Margin="0,7,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PresetCard}" Margin="0,0,6,0" Padding="9,7"
                                    Command="{Binding ApplyCommand}" CommandParameter="{Binding Id}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource AmberBrush}" HorizontalAlignment="Right"
                                                 VerticalAlignment="Center" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Message}" Style="{StaticResource SettingHint}" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Timing" Style="{StaticResource H2}" />
                    <Grid Margin="0,7,0,0">
                        <TextBlock Text="Work interval" Style="{StaticResource SettingLabel}" FontSize="11" />
                        <TextBlock Text="{Binding WorkMinutes, StringFormat={}{0} min}" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                    <Slider AutomationProperties.Name="Work interval in minutes" Style="{StaticResource AppSlider}" Minimum="5" Maximum="90" TickFrequency="5"
                            IsSnapToTickEnabled="True" Value="{Binding WorkMinutes, Mode=TwoWay}" />
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="Short break" Style="{StaticResource SettingLabel}" FontSize="11" />
                        <TextBlock Text="{Binding ShortBreakSeconds, StringFormat={}{0} sec}" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                    <Slider AutomationProperties.Name="Short break in seconds" Style="{StaticResource AppSlider}" Minimum="5" Maximum="300" TickFrequency="5"
                            IsSnapToTickEnabled="True" Value="{Binding ShortBreakSeconds, Mode=TwoWay}" />
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="Long break" Style="{StaticResource SettingLabel}" FontSize="11" />
                        <TextBlock Text="{Binding LongBreakMinutes, StringFormat={}{0} min}" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                    <Slider AutomationProperties.Name="Long break in minutes" Style="{StaticResource AppSlider}" Minimum="1" Maximum="30" TickFrequency="1"
                            IsSnapToTickEnabled="True" Value="{Binding LongBreakMinutes, Mode=TwoWay}" />
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="Long break every" Style="{StaticResource SettingLabel}" FontSize="11" />
                        <TextBlock Text="{Binding LongBreakEvery, StringFormat={}{0} breaks}" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                    <Slider AutomationProperties.Name="Work intervals before a long break" Style="{StaticResource AppSlider}" Minimum="2" Maximum="12" TickFrequency="1"
                            IsSnapToTickEnabled="True" Value="{Binding LongBreakEvery, Mode=TwoWay}" />
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="Warning before a break" Style="{StaticResource SettingLabel}" FontSize="11" />
                        <TextBlock Text="{Binding PreBreakSeconds, StringFormat={}{0} sec}" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                    <Slider AutomationProperties.Name="Warning before a break in seconds" Style="{StaticResource AppSlider}" Minimum="0" Maximum="60" TickFrequency="15"
                            IsSnapToTickEnabled="True" Value="{Binding PreBreakSeconds, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14">
                <StackPanel>
                    <TextBlock Text="How a break appears" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding StyleDescription}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,6" />
                    <RadioButton Style="{StaticResource ChoiceCard}" GroupName="BreakStyle" Margin="0,0,0,5" Padding="9,7"
                                 IsChecked="{Binding Style, Converter={StaticResource EnumToBoolean}, ConverterParameter=Gentle, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Text="Gentle" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="A small card. Keep working if you need to." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChoiceCard}" GroupName="BreakStyle" Margin="0,0,0,5" Padding="9,7"
                                 IsChecked="{Binding Style, Converter={StaticResource EnumToBoolean}, ConverterParameter=Fullscreen, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Text="Full-screen" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="A calm pause that can be skipped." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChoiceCard}" GroupName="BreakStyle" Padding="9,7"
                                 IsChecked="{Binding Style, Converter={StaticResource EnumToBoolean}, ConverterParameter=Strict, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Text="Strict" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="The pause stays until the timer ends." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </RadioButton>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,7" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Sound at start and end" FontSize="11"
                                  IsChecked="{Binding SoundEnabled, Mode=TwoWay}" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Hold 3 seconds to skip" FontSize="11"
                                  IsChecked="{Binding HoldToSkip, Mode=TwoWay}" Margin="0,7,0,0" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Pause when I step away" FontSize="11"
                                  IsChecked="{Binding PauseWhenIdle, Mode=TwoWay}" Margin="0,7,0,0" />
                    <Grid Margin="0,3,0,0" Visibility="{Binding PauseWhenIdle, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Away after" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding IdleMinutes, StringFormat={}{0} min}" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                    <Slider AutomationProperties.Name="Idle time before pausing in minutes" Style="{StaticResource AppSlider}" Minimum="1" Maximum="15" TickFrequency="1"
                            IsSnapToTickEnabled="True" Value="{Binding IdleMinutes, Mode=TwoWay}"
                            Visibility="{Binding PauseWhenIdle, Converter={StaticResource BoolToVisibility}}" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Restart interval after away" FontSize="11"
                                  IsChecked="{Binding RestartAfterIdle, Mode=TwoWay}" Margin="0,3,0,0" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Pause in full-screen apps" FontSize="11"
                                  IsChecked="{Binding PauseInFullscreen, Mode=TwoWay}" Margin="0,7,0,0" />
                    <ToggleButton Style="{StaticResource SwitchToggle}" Content="Lock Windows at break end" FontSize="11"
                                  IsChecked="{Binding LockAtEnd, Mode=TwoWay}" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
