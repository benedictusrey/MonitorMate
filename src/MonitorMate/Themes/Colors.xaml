<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Warm workshop palette: olive-black, ivory, persimmon, celadon. -->
    <Color x:Key="Ink0Color">#10130F</Color>
    <Color x:Key="Ink1Color">#151A15</Color>
    <Color x:Key="SurfaceColor">#1A211A</Color>
    <Color x:Key="SurfaceRaisedColor">#222B22</Color>
    <Color x:Key="BorderColor">#2F3A2F</Color>
    <Color x:Key="BorderStrongColor">#465546</Color>
    <Color x:Key="TextPrimaryColor">#F4EFE4</Color>
    <Color x:Key="TextSecondaryColor">#B7BFB2</Color>
    <Color x:Key="TextMutedColor">#889384</Color>
    <Color x:Key="AmberColor">#E07A5F</Color>
    <Color x:Key="AmberHoverColor">#EE8D70</Color>
    <Color x:Key="AmberInkColor">#2B0F08</Color>
    <Color x:Key="MintColor">#A9C6B2</Color>
    <Color x:Key="MintInkColor">#102017</Color>
    <Color x:Key="SandColor">#D8B36A</Color>
    <Color x:Key="SlateColor">#91AFC4</Color>
    <Color x:Key="DangerColor">#D96A5A</Color>

    <SolidColorBrush x:Key="Ink0Brush" Color="{StaticResource Ink0Color}" />
    <SolidColorBrush x:Key="Ink1Brush" Color="{StaticResource Ink1Color}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberHoverBrush" Color="{StaticResource AmberHoverColor}" />
    <SolidColorBrush x:Key="AmberInkBrush" Color="{StaticResource AmberInkColor}" />
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
    <SolidColorBrush x:Key="MintInkBrush" Color="{StaticResource MintInkColor}" />
    <SolidColorBrush x:Key="SandBrush" Color="{StaticResource SandColor}" />
    <SolidColorBrush x:Key="SlateBrush" Color="{StaticResource SlateColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#10130F" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#141914" />
    <SolidColorBrush x:Key="CardBrush" Color="#1A211A" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#222B22" />
    <SolidColorBrush x:Key="InputBrush" Color="#151C16" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#990C100D" />
</ResourceDictionary>
