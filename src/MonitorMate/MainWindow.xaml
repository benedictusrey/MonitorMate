<Window x:Class="MonitorMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:MonitorMate.Core.ViewModels"
        xmlns:views="clr-namespace:MonitorMate.Views"
        xmlns:controls="clr-namespace:MonitorMate.Controls"
        Title="MonitorMate"
        Icon="/MonitorMate;component/Assets/monitormate.ico"
        Width="1040" Height="650" MinWidth="920" MinHeight="610"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing" StateChanged="Window_StateChanged" Style="{StaticResource {x:Type Window}}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TodayViewModel}">
            <views:TodayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DisplaysViewModel}">
            <views:DisplaysView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComfortViewModel}">
            <views:ComfortView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BreaksViewModel}">
            <views:BreaksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FocusViewModel}">
            <views:FocusView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
            <views:ActivityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/monitormate.ico" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="MonitorMate" Margin="9,0,0,0" FontFamily="{StaticResource DisplayFont}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource PillBorder}" Padding="6,1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="1.0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusHeadline}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" MaxWidth="230" TextTrimming="CharacterEllipsis" />
                    <Button Content="{Binding PauseLabel}" Style="{StaticResource FlatButton}" Padding="7,4"
                            Command="{Binding TogglePauseCommand}" Margin="10,0,0,0" />
                    <Button Content="Take a break" Style="{StaticResource SecondaryButton}" Padding="10,5"
                            Command="{Binding TakeBreakCommand}" Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize window">
                        <Path Data="{StaticResource IconMinus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Maximize_Click" ToolTip="Maximize"
                            AutomationProperties.Name="Maximize window">
                        <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Close"
                            AutomationProperties.Name="Close window">
                        <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="10,12,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox x:Name="NavList" ItemsSource="{Binding NavItems}"
                                 SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                                 Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItemContainer}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{Binding Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1">
                            <StackPanel Margin="4,0,4,9">
                                <TextBlock Text="Today" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TodayPage.ScreenTimeText}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="16" />
                                        <TextBlock Text="screen time" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding TodayPage.BreaksText}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="16" />
                                        <TextBlock Text="breaks" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding TodayPage.FocusText}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="16" />
                                        <TextBlock Text="focused" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding TodayPage.CurrentPeriod}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="14" />
                                        <TextBlock Text="period" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="Open activity" Style="{StaticResource FlatButton}" Padding="0,4,0,0"
                                        FontSize="11" Command="{Binding OpenActivityCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="2,0,2,11" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:MateFace Width="34" Height="29" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <TextBlock Text="Your MonitorMate" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MateLine}" Style="{StaticResource SettingHint}"
                                               Margin="0,2,0,0" MaxWidth="126" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding NextBreakText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="Local-only care. No account. No upload." FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page content -->
                <Grid Grid.Column="1" Background="{StaticResource WindowBackgroundBrush}">
                    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="20,18,18,18">
                        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Focusable="False">
                            <ContentControl.RenderTransform>
                                <TranslateTransform x:Name="PageTranslate" Y="0" />
                            </ContentControl.RenderTransform>
                        </ContentControl>
                    </ScrollViewer>

                    <Border x:Name="LoadingLayer" Background="{StaticResource OverlayBrush}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                            <controls:MateFace Width="46" Height="38" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding LoadingText}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="Your displays are not being changed during this check." FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                       Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ErrorBanner" Background="#2A1B16" BorderBrush="#6E4036" BorderThickness="1"
                            CornerRadius="7" Margin="20,10,18,0" Padding="11,8" VerticalAlignment="Top"
                            Visibility="{Binding InitializationError, Converter={StaticResource StringToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding InitializationError}" FontSize="11.5" Foreground="#F4D4C8" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="Dismiss" Style="{StaticResource FlatButton}"
                                    Command="{Binding DismissErrorCommand}" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

