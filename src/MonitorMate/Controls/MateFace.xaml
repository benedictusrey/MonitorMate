<UserControl x:Class="MonitorMate.Controls.MateFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="MonitorMate"
             IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="64" Height="54">
            <Line X1="32" Y1="3" X2="32" Y2="9" Stroke="{StaticResource TextSecondaryBrush}"
                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Ellipse Canvas.Left="29" Canvas.Top="0" Width="6" Height="6" Fill="{StaticResource AmberBrush}" />
            <Rectangle Canvas.Left="5" Canvas.Top="9" Width="54" Height="36" RadiusX="9" RadiusY="9"
                       Fill="{StaticResource SurfaceRaisedBrush}" Stroke="{StaticResource TextSecondaryBrush}"
                       StrokeThickness="2" />
            <Ellipse Canvas.Left="20" Canvas.Top="22" Width="5" Height="7" Fill="{StaticResource TextPrimaryBrush}" />
            <Ellipse Canvas.Left="39" Canvas.Top="22" Width="5" Height="7" Fill="{StaticResource TextPrimaryBrush}" />
            <Path Data="M 22 35 Q 32 41 42 35" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Rectangle Canvas.Left="25" Canvas.Top="46" Width="14" Height="2" RadiusX="1" RadiusY="1"
                       Fill="{StaticResource BorderStrongBrush}" />
            <Rectangle Canvas.Left="19" Canvas.Top="49" Width="26" Height="2" RadiusX="1" RadiusY="1"
                       Fill="{StaticResource BorderBrush}" />
        </Canvas>
    </Viewbox>
</UserControl>

