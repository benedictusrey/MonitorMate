<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MonitorMate.Desktop.App" RequestedThemeVariant="Dark">
<Application.Styles>
<FluentTheme />
<Style Selector="Window"><Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#10130F"/><Setter Property="Foreground" Value="#F4EFE4"/></Style>
<Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style Selector="TextBlock.title"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="#B7BFB2"/></Style>
<Style Selector="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="14,8"/></Style>
<Style Selector="Button.primary"><Setter Property="Background" Value="#E07A5F"/><Setter Property="Foreground" Value="#2B0F08"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style Selector="Border.panel"><Setter Property="Background" Value="#1A211A"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="24"/></Style>
</Application.Styles>
</Application>