<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
    IgnorableNamespaces="uap rescap uap10">

  <!-- Replace Name and Publisher with the values from Partner Center before submitting. -->
  <Identity
      Name="MonitorMate"
      Publisher="CN=MonitorMate"
      Version="1.0.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MonitorMate</DisplayName>
    <PublisherDisplayName>Benedictus RH</PublisherDisplayName>
    <Description>Local-first display comfort for Windows.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
        Name="Windows.Desktop"
        MinVersion="10.0.19041.0"
        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
        Id="MonitorMate"
        Executable="MonitorMate.exe"
        EntryPoint="Windows.FullTrustApplication"
        uap10:TrustLevel="mediumIL"
        uap10:RuntimeBehavior="packagedClassicApp">
      <uap:VisualElements
          AppListEntry="default"
          DisplayName="MonitorMate"
          Description="Local-first display comfort for Windows."
          BackgroundColor="#10130F"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            Wide310x150Logo="Assets\Wide310x150Logo.png"
            Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
